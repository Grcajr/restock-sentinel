# Copy this file to .env and fill in real values. Never commit .env.

# Discord webhook URL used for restock alerts.
# Create one via: Server Settings -> Integrations -> Webhooks -> New Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxx/xxxxx

# Path to the SQLite database file.
DATABASE_PATH=data/restock_sentinel.db

# How often (in seconds) each tracked product is re-checked.
CHECK_INTERVAL_SECONDS=60

# Set to "true" to run Playwright in headless mode (recommended for servers).
PLAYWRIGHT_HEADLESS=true

# Set to "true" to actually attempt a dry-run checkout (add-to-cart -> checkout,
# stopping before payment) when a restock is detected. "false" just sends alerts.
ENABLE_DRY_RUN_CHECKOUT=false
